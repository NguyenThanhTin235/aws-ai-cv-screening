# ==============================================================================
# AWS AI CV Screening Portal - Frontend Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development or configure in AWS Amplify
# ==============================================================================

# API Gateway Base URL (From CDK ComputeAndApiStack output: ApiUrlOutput or CloudFrontDomainOutput)
VITE_API_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev/

# Amazon Cognito User Pool Configuration (From CDK AuthAndEdgeStack output)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region
VITE_REGION=us-east-1

# Optional WebSocket URL for real-time AI push (Phase 3)
VITE_WS_URL=wss://<ws-api-id>.execute-api.us-east-1.amazonaws.com/dev

